  "components": [
    {
      "name": "Buttons",
      "group": "Actions",
      "summary": "Primary, secondary, ghost, Call and WhatsApp buttons in sizes M and L."
    },
    {
      "name": "ContactBlocks",
      "group": "Contact",
      "summary": "Contact info card, opening hours table and static map block."
    },
    {
      "name": "ContactDesktopAR",
      "group": "Templates"
    },
    {
      "name": "ContactDesktopFR",
      "group": "Templates"
    },
    {
      "name": "ContactMobile",
      "group": "Templates"
    },
    {
      "name": "FaqAccordion",
      "group": "Content",
      "summary": "Accordion of questions and answers with a 220ms open and close."
    },
    {
      "name": "Feedback",
      "group": "Feedback",
      "summary": "Badge, chip, alert and toast components."
    },
    {
      "name": "FloatingWhatsApp",
      "group": "Actions",
      "summary": "Floating WhatsApp button fixed at the end corner of the viewport."
    },
    {
      "name": "Footer",
      "group": "Navigation",
      "summary": "Brown-surface footer with logo, quick links, address, hours, phone, e-mail and social links."
    },
    {
      "name": "Forms",
      "group": "Forms",
      "summary": "Contact form controls: text, phone, select, textarea, helper and error text, success banner and a submit button with a loading state."
    },
    {
      "name": "Gallery",
      "group": "Images",
      "summary": "Photo grid of 1:1 and 4:3 tiles with a lightbox that opens on activation."
    },
    {
      "name": "Header",
      "group": "Navigation",
      "summary": "Site header with logo, navigation, language switcher and Call button; below 1024px it collapses to a menu button and a drawer."
    },
    {
      "name": "Hero",
      "group": "Content",
      "summary": "Home hero with overline, display title, intro, two calls to action and a hero image slot."
    },
    {
      "name": "HomeDesktopAR",
      "group": "Templates"
    },
    {
      "name": "HomeDesktopFR",
      "group": "Templates"
    },
    {
      "name": "HomeMobile",
      "group": "Templates"
    },
    {
      "name": "Icons",
      "group": "Identity",
      "summary": "The 17-icon line set: 24px grid, 1.5px line, round caps."
    },
    {
      "name": "ImagePlaceholder",
      "group": "Images",
      "summary": "Static cream image slot with a low-opacity logo watermark and a fixed aspect ratio."
    },
    {
      "name": "LanguageSwitcher",
      "group": "Navigation",
      "summary": "FR | AR switch as a pill with the current language filled."
    },
    {
      "name": "Links",
      "group": "Actions",
      "summary": "Underlined text links plus inline phone, e-mail and arrow links."
    },
    {
      "name": "Logo",
      "group": "Identity",
      "summary": "Plain-type wordmark \"LA COLOMBE\" with the mill name underneath, standing in until the logo file is attached."
    },
    {
      "name": "ProductCard",
      "group": "Products",
      "summary": "Product card (image 4:3, range, name, description, sizes, link) and the larger product section block."
    },
    {
      "name": "ProductsDesktopAR",
      "group": "Templates"
    },
    {
      "name": "ProductsDesktopFR",
      "group": "Templates"
    },
    {
      "name": "ProductsMobile",
      "group": "Templates"
    },
    {
      "name": "SectionHeader",
      "group": "Content",
      "summary": "Overline, title, gold rule and intro that open each section."
    },
    {
      "name": "SocialLinks",
      "group": "Contact",
      "summary": "Facebook and Instagram icon links."
    },
    {
      "name": "StrengthItem",
      "group": "Content",
      "summary": "A circular icon, a short title and one line of text."
    },
    {
      "name": "TestimonialCard",
      "group": "Content",
      "summary": "Quote card with name and role and an initial instead of a photo."
    }
